{
  "name": "dsh-client-ui-filetree",
  "version": "0.1.0",
  "description": "Collapsible real-time file-tree drawer for the dsh web GUI — 100% pure plugin (TS/TSX source, tsdown build).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "scripts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/virtual-core": "^3.17.7",
    "@types/react": "^18.3.1",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  }
}
