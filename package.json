{
  "name": "dsh-explorer-repo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Umbrella bundle: installs both dsh-explorer (host) and dsh-client-ui-explorer (browser).",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-explorer": "github:No-PRM/dsh-explorer#main&path:/dsh-plugins/dsh-explorer",
    "dsh-client-ui-explorer": "github:No-PRM/dsh-explorer#main&path:/dsh-plugins/dsh-client-ui-explorer"
  }
}
